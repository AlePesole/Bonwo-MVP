# Copy this file to .env and adjust as needed.
# Used by both docker-compose.yml and the Spring Boot app (application.yaml).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bonwoapp
DB_USER=user
DB_PASSWORD=user123

# Must be overridden with a strong secret outside of local dev.
JWT_SECRET=dev-only-change-me-this-must-be-at-least-32-bytes-long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

MEDIA_PENDING_TTL_MINUTES=15

# Optional — if all three are set, an admin user is seeded on startup (skipped if it already exists).
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required — get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=